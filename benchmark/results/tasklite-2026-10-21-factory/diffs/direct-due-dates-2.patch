@@ -40,5 +44,9 @@ class Store:
         self.save()
         return self.tasks[task_id]
 
-    def all(self):
-        return sorted(self.tasks.values(), key=lambda t: t.id)
+    def all(self, overdue=False):
+        tasks = sorted(self.tasks.values(), key=lambda t: t.id)
