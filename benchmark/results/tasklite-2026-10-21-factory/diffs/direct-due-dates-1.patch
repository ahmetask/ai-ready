 import argparse
 import sys
+from datetime import date
 
 from .store import Store
 
 
+def iso_date(text):
+    try:
+        return date.fromisoformat(text).isoformat()
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid date {text!r}, expected YYYY-MM-DD")
+
+
 def main(argv=None, store=None):
     parser = argparse.ArgumentParser(prog="tasklite")
     sub = parser.add_subparsers(dest="command", required=True)
     add = sub.add_parser("add", help="add a task")
     add.add_argument("title")
-    sub.add_parser("list", help="list tasks")
+    add.add_argument("--due", type=iso_date, help="due date, YYYY-MM-DD")
+    ls = sub.add_parser("list", help="list tasks")
+    ls.add_argument("--overdue", action="store_true", help="only open tasks past due")
     done = sub.add_parser("done", help="mark a task done")
     done.add_argument("id", type=int)
     sub.add_parser("stats", help="summary of tasks")
@@ -19,11 +29,12 @@ def main(argv=None, store=None):
