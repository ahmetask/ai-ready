index f7f0a73..caf1be1 100644
--- a/tasklite/store.py
+++ b/tasklite/store.py
@@ -3,6 +3,8 @@
 import json
 import os
 from dataclasses import asdict, dataclass
+from datetime import date
+from typing import Optional
 
 DEFAULT_PATH = os.environ.get("TASKLITE_FILE", "tasks.json")
 
@@ -12,6 +14,7 @@ class Task:
     id: int
     title: str
     done: bool = False
+    due: Optional[str] = None  # ISO date, YYYY-MM-DD; absent in older files
 
 
 class Store:
@@ -29,8 +32,10 @@ class Store:
         with open(self.path, "w") as fh:
             json.dump([asdict(t) for t in self.tasks.values()], fh, indent=2)
 
-    def add(self, title):
-        task = Task(id=max(self.tasks, default=0) + 1, title=title)
+    def add(self, title, due=None):
+        if due is not None:
+            due = date.fromisoformat(due).isoformat()  # ValueError if malformed
+        task = Task(id=max(self.tasks, default=0) + 1, title=title, due=due)
         self.tasks[task.id] = task
         self.save()
         return task
@@ -42,3 +47,9 @@ class Store:
 
     def all(self):
         return sorted(self.tasks.values(), key=lambda t: t.id)
+
+    def overdue(self, today=None):
+        """Open tasks due before today, oldest due date first."""
+        today = (today or date.today()).isoformat()
+        late = [t for t in self.tasks.values() if not t.done and t.due and t.due < today]
+        return sorted(late, key=lambda t: (t.due, t.id))
