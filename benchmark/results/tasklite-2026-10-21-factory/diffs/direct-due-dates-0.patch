 import argparse
 import sys
+from datetime import date
 
 from .store import Store
 
 
+def iso_date(value):
+    try:
+        date.fromisoformat(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid date {value!r}, expected YYYY-MM-DD")
+    return value
+
+
 def main(argv=None, store=None):
     parser = argparse.ArgumentParser(prog="tasklite")
     sub = parser.add_subparsers(dest="command", required=True)
     add = sub.add_parser("add", help="add a task")
     add.add_argument("title")
-    sub.add_parser("list", help="list tasks")
+    add.add_argument("--due", type=iso_date, help="due date, YYYY-MM-DD")
+    lst = sub.add_parser("list", help="list tasks")
+    lst.add_argument("--overdue", action="store_true", help="only open tasks past due")
     done = sub.add_parser("done", help="mark a task done")
     done.add_argument("id", type=int)
     sub.add_parser("stats", help="summary of tasks")
@@ -19,11 +30,12 @@ def main(argv=None, store=None):
     store = store or Store()
 
     if args.command == "add":
-        task = store.add(args.title)
+        task = store.add(args.title, due=args.due)
         print(f"added {task.id}: {task.title}")
     elif args.command == "list":
-        for task in store.all():
-            print(f"[{'x' if task.done else ' '}] {task.id} {task.title}")
+        for task in store.overdue() if args.overdue else store.all():
+            due = f" (due {task.due})" if task.due else ""
+            print(f"[{'x' if task.done else ' '}] {task.id} {task.title}{due}")
     elif args.command == "done":
         task = store.complete(args.id)
         print(f"done {task.id}: {task.title}")
