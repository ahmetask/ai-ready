+    def test_due_and_overdue(self):
+        store = Store(self.path)
+        store.add("old", due="2026-01-01")
+        store.add("future", due="2999-01-01")
+        store.add("undated")
+        store.add("finished", due="2026-01-01")
+        store.complete(4)
+        self.assertEqual([t.title for t in Store(self.path).overdue()], ["old"])
