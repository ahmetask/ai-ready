@@ -1,3 +1,5 @@
+import datetime
+import json
 import os
 import tempfile
 import unittest
@@ -20,3 +22,36 @@ class StoreTest(unittest.TestCase):
         store.complete(1)
         reloaded = Store(self.path)
         self.assertEqual([(t.id, t.done) for t in reloaded.all()], [(1, True), (2, False)])
+
+    def test_old_file_without_due_loads(self):
+        with open(self.path, "w") as fh:
+            json.dump([{"id": 1, "title": "old", "done": False}], fh)
+        store = Store(self.path)
+        self.assertIsNone(store.all()[0].due)
+
+    def test_add_invalid_due_raises(self):
+        store = Store(self.path)
+        for bad in ("garbage", "2024-13-45", 5):
+            with self.assertRaises(ValueError):
+                store.add("x", bad)
+        self.assertEqual(store.all(), [])
+
+    def test_overdue_with_pinned_today(self):
+        store = Store(self.path)
+        store.add("a", "2024-01-01")
+        store.add("b", "2024-01-10")
+        self.assertEqual([t.id for t in store.overdue(today=datetime.date(2024, 1, 5))], [1])
+        self.assertEqual([t.id for t in store.overdue(datetime.date(2024, 1, 11))], [1, 2])
+
+    def test_overdue(self):
+        today = datetime.date.today()
+        past = (today - datetime.timedelta(days=1)).isoformat()
+        future = (today + datetime.timedelta(days=1)).isoformat()
+        store = Store(self.path)
+        store.add("late", past)
+        store.add("done late", past)
+        store.add("later", future)
+        store.add("today", today.isoformat())
+        store.add("no due")
+        store.complete(2)
+        self.assertEqual([t.id for t in Store(self.path).overdue()], [1])
