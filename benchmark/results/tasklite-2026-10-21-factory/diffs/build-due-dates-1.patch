@@ -5,7 +5,8 @@ standard library only.
 
 ```
 python3 -m tasklite add "buy milk"
-python3 -m tasklite list
+python3 -m tasklite add "pay rent" --due 2026-11-01   # optional due date, YYYY-MM-DD
+python3 -m tasklite list             # shows "(due DATE)"; --overdue lists open tasks past due
