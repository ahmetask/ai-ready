 """Task storage: a JSON file holding a list of tasks."""
 
+import datetime
 import json
 import os
 from dataclasses import asdict, dataclass
+from typing import Optional
 
 DEFAULT_PATH = os.environ.get("TASKLITE_FILE", "tasks.json")
 
@@ -12,6 +14,7 @@ class Task:
     id: int
     title: str
     done: bool = False
+    due: Optional[str] = None
 
 
 class Store:
@@ -29,8 +32,15 @@ class Store:
         with open(self.path, "w") as fh:
             json.dump([asdict(t) for t in self.tasks.values()], fh, indent=2)
 
-    def add(self, title):
-        task = Task(id=max(self.tasks, default=0) + 1, title=title)
+    def add(self, title, due=None):
+        if due is not None:
+            try:
+                datetime.date.fromisoformat(due)
+            except (TypeError, ValueError):
+                raise ValueError("due must be YYYY-MM-DD: %r" % (due,))
+            if len(due) != 10:
+                raise ValueError("due must be YYYY-MM-DD: %r" % (due,))
+        task = Task(id=max(self.tasks, default=0) + 1, title=title, due=due)
         self.tasks[task.id] = task
         self.save()
         return task
@@ -42,3 +52,7 @@ class Store:
 
     def all(self):
         return sorted(self.tasks.values(), key=lambda t: t.id)
+
+    def overdue(self, today=None):
+        today = (today or datetime.date.today()).isoformat()
+        return [t for t in self.all() if not t.done and t.due and t.due < today]
