{
  "instruction_files": [
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "max_instructions_lines": 60,
  "max_instructions_bytes": 4000,
  "ignore": [
    "plugins/ai-ready/skills/**"
  ],
  "fail_on": "error",
  "min_score": 90,
  "doc_watch": [
    {
      "paths": [
        "plugins/ai-ready/scripts/*"
      ],
      "docs": [
        "README.md"
      ],
      "message": "the checker changed; update README.md if its flags or checks changed",
      "severity": "warning"
    },
    {
      "paths": [
        ".ai-ready/components.json"
      ],
      "docs": [
        "docs/architecture.md"
      ],
      "severity": "warning",
      "message": "the component map changed; update the table in docs/architecture.md"
    },
    {
      "paths": [
        "plugins/ai-ready/commands/*",
        "plugins/ai-ready/hooks/*"
      ],
      "docs": [
        "README.md"
      ],
      "severity": "warning",
      "message": "a command or hook changed; update README.md if its behaviour did"
    }
  ]
}
